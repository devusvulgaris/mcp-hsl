{
  "name": "mcp-hsl",
  "version": "0.1.0",
  "description": "MCP server exposing Greater Helsinki (HSL) public-transport data from Digitransit.fi",
  "type": "module",
  "bin": {
    "mcp-hsl": "./build/stdio.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/stdio.js",
    "start": "node --env-file=.env build/stdio.js",
    "prepublishOnly": "rm -rf build && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devusvulgaris/mcp-hsl.git"
  },
  "homepage": "https://github.com/devusvulgaris/mcp-hsl#readme",
  "bugs": {
    "url": "https://github.com/devusvulgaris/mcp-hsl/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "greater helsinki",
    "helsinki",
    "hsl",
    "digitransit",
    "transit"
  ],
  "author": "Oleg Elizarov",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "graphql-request": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
